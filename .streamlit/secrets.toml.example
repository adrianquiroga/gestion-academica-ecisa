# Plantilla de configuración de secretos para Streamlit
# Copia este archivo como `.streamlit/secrets.toml` y reemplaza con tus credenciales reales.
# IMPORTANTE: Nunca subas `.streamlit/secrets.toml` a Git.

# 1. Credenciales de Supabase (Settings -> API en tu proyecto de Supabase)
SUPABASE_URL = "https://tu-proyecto-id.supabase.co"
SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Puente de Google Apps Script hacia Google Drive Institucional
APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycb.../exec"
DRIVE_API_TOKEN = "cambia-este-token-por-una-clave-secreta-segura-2026"

# 3. Credenciales del Usuario Administrador (Opcional - por defecto admin / admin2026)
ADMIN_USER = "admin"
ADMIN_PASS = "admin2026"

